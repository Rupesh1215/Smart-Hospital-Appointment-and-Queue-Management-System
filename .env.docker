# ==========================================
# Smart Hospital — Docker Environment Variables
# ==========================================
# Copy this file or edit in place before running:
#   docker-compose up --build
# ==========================================

# --- JWT Authentication ---
# IMPORTANT: Change this in production! Must be at least 256 bits.
JWT_SECRET=SmartHospitalSecretKeyForJWTAuth2026SuperSecureKey

# --- Google Gemini AI ---
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- MongoDB (optional overrides) ---
# These are set in docker-compose.yml by default.
# Uncomment to override:
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=changeme
